rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1 Each user can read/write their own profile image
    match /users/{userId}/profile {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // 2 Chatroom media — any authenticated user can upload & read
    match /chatrooms/{chatroomId}/media/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 3 Optional public assets
    match /public/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // 4 Everything else is denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
