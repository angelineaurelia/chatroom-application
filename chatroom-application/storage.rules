rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow each user to read & write their own profile image
    match /users/{userId}/profile {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // (Optional) Allow chatroom avatars if you’ve implemented them
    match /chatrooms/{roomId}/avatar {
      allow read;  // public images
      allow write: if request.auth != null
        && request.auth.uid in
            resource.metadata.members;  // or some other rule
    }

    // By default, deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
