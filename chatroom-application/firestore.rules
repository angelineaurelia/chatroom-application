rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chatrooms: only members can list/get/create
    match /chatrooms/{roomId} {
      allow list, get: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time;
    }

    // Messages subcollection: only room members can read/write
    match /chatrooms/{roomId}/messages/{messageId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(
          /databases/$(database)/documents/chatrooms/$(roomId)
        ).data.members;
    }

    // Users: allow authenticated users to upsert their own record and read the list
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}